@using Weather_Forecast.Models

<div class="hourly-forecast-container glass-card">
    <div class="hourly-header">
        <div class="header-title">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
            </svg>
            <h4>Hourly & 3-Hour Breakdown</h4>
        </div>
        <span class="hourly-count">@Items.Count slots</span>
    </div>

    <div class="hourly-scroll-wrapper">
        @foreach (var item in Items)
        {
            DateTime dt = DateTimeOffset.FromUnixTimeSeconds(item.Dt).LocalDateTime;
            string weatherMain = item.Weather?.FirstOrDefault()?.Main ?? "Clear";
            double pop = Math.Round(item.Pop * 100);

            <div class="hourly-card">
                <div class="hourly-time">@dt.ToString("HH:mm")</div>
                <div class="hourly-date">@dt.ToString("ddd")</div>

                <div class="hourly-icon-box">
                    @GetWeatherSvg(weatherMain, item.Sys?.Pod == "n")
                </div>

                <div class="hourly-temp">@Math.Round(item.Main?.Temp ?? 0, 0)@UnitSymbol</div>

                @if (pop > 0)
                {
                    <div class="hourly-pop-badge" title="Precipitation Probability">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
                        </svg>
                        <span>@pop%</span>
                    </div>
                }
                else
                {
                    <div class="hourly-pop-badge empty">
                        <span>0%</span>
                    </div>
                }

                <div class="hourly-wind" title="Wind speed">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="transform: rotate(@(item.Wind?.Deg ?? 0)deg)">
                        <line x1="12" y1="19" x2="12" y2="5" />
                        <polyline points="5 12 12 5 19 12" />
                    </svg>
                    <span>@Math.Round(item.Wind?.Speed ?? 0, 1)m/s</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<ForecastItem> Items { get; set; } = new();
    [Parameter] public TemperatureUnit Unit { get; set; } = TemperatureUnit.Celsius;

    private string UnitSymbol => Unit == TemperatureUnit.Celsius ? "°C" : "°F";

    private RenderFragment GetWeatherSvg(string condition, bool isNight) => builder =>
    {
        switch (condition.ToLowerInvariant())
        {
            case "clear":
                if (isNight)
                {
                    builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' class='weather-svg svg-moon' width='32' height='32' fill='none' stroke='#f6d365' stroke-width='2'><path d='M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z'/></svg>");
                }
                else
                {
                    builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' class='weather-svg svg-sun' width='32' height='32' fill='none' stroke='#ffb347' stroke-width='2'><circle cx='12' cy='12' r='5'/><line x1='12' y1='1' x2='12' y2='3'/><line x1='12' y1='21' x2='12' y2='23'/><line x1='4.22' y1='4.22' x2='5.64' y2='5.64'/><line x1='18.36' y1='18.36' x2='19.78' y2='19.78'/><line x1='1' y1='12' x2='3' y2='12'/><line x1='21' y1='12' x2='23' y2='12'/><line x1='4.22' y1='19.78' x2='5.64' y2='18.36'/><line x1='18.36' y1='5.64' x2='19.78' y2='4.22'/></svg>");
                }
                break;
            case "clouds":
                builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' class='weather-svg svg-cloud' width='32' height='32' fill='none' stroke='#a1c4fd' stroke-width='2'><path d='M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z'/></svg>");
                break;
            case "rain":
            case "drizzle":
                builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' class='weather-svg svg-rain' width='32' height='32' fill='none' stroke='#4facfe' stroke-width='2'><path d='M16 13v8M8 13v8M12 15v8'/><path d='M20 16.58A5 5 0 0 0 18 7h-1.26A8 8 0 1 0 4 15.25'/></svg>");
                break;
            case "thunderstorm":
                builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' class='weather-svg svg-thunder' width='32' height='32' fill='none' stroke='#f093fb' stroke-width='2'><path d='M19 16.9A5 5 0 0 0 18 7h-1.26A8 8 0 1 0 4 15.25'/><polyline points='13 11 9 17 15 17 11 23'/></svg>");
                break;
            case "snow":
                builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' class='weather-svg svg-snow' width='32' height='32' fill='none' stroke='#e0c3fc' stroke-width='2'><path d='M20 17.58A5 5 0 0 0 18 8h-1.26A8 8 0 1 0 4 16.25'/><line x1='8' y1='16' x2='8.01' y2='16'/><line x1='12' y1='18' x2='12.01' y2='18'/><line x1='16' y1='16' x2='16.01' y2='16'/></svg>");
                break;
            default:
                builder.AddMarkupContent(0, @"<svg viewBox='0 0 24 24' class='weather-svg' width='32' height='32' fill='none' stroke='#888' stroke-width='2'><path d='M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z'/></svg>");
                break;
        }
    };
}
